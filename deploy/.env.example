# mysql-backup reference configuration. Copy to .env next to compose.yaml.
# Comments stay on their own lines because not every stack manager strips
# inline comments. Values are unquoted (Compose reads to end of line).
# Every value below is an EXAMPLE. Addresses use the RFC 5737 documentation
# range (192.0.2.0/24) and must be replaced.
#
# Run one stack per database and environment. Production and development
# must use different BACKUP_NAMESPACE values (and preferably different
# COMPOSE_PROJECT_NAME values); namespaces keep their files, locks, status and
# retention completely separate, even on shared staging/NFS storage.

COMPOSE_PROJECT_NAME=myapp-backup-prod

# Pin a release; see docs/upgrade.md for digest pinning.
MYSQL_BACKUP_IMAGE=ghcr.io/tensegrity-labs/mysql-backup:0.1.0

# --- general -------------------------------------------------------------
# false = no dumps, deliveries or pruning at all
BACKUP_ENABLED=true
# [a-z0-9][a-z0-9._-]*; part of every file name
BACKUP_NAMESPACE=myapp-prod
# schedule and retention calendar
BACKUP_TZ=America/Denver
# minute hour dom month dow: hourly 06:00-21:00 daily
BACKUP_SCHEDULE=0 6-21 * * *
# also dump once whenever the producer starts
BACKUP_ON_START=false

# --- database (existing server, reached over its Docker network) ----------
# `docker network ls`; the DB container must be on it
MYSQL_NETWORK=myapp_default
# service name / alias on that network
MYSQL_HOST=db
MYSQL_PORT=3306
# exactly one database per producer
MYSQL_DATABASE=myapp
MYSQL_USER=backup
# file on the host, one line, mode 0600
MYSQL_PASSWORD_HOST_FILE=./secrets/mysql_password
MYSQL_SSL_MODE=PREFERRED
# owner of the staging directory on the host
BACKUP_UID=999
BACKUP_GID=999

# --- local staging ------------------------------------------------------
# A dedicated filesystem mounted on the host; must contain .mysql-backup-staging
STAGING_HOST_PATH=/srv/backup-staging
# optional: required first line of the marker file
STAGING_MARKER_ID=
# optional: e.g. ext4 or xfs
STAGING_EXPECT_FSTYPE=
# free space never used by dumps
STAGING_RESERVE=2G
# reserve is max(STAGING_RESERVE, this % of the fs)
STAGING_RESERVE_PERCENT=5
# 0 = unlimited (capacity still applies)
STAGING_MAX_PENDING_COUNT=0
STAGING_MAX_PENDING_BYTES=0
# delivered dumps kept locally for this long
LOCAL_KEEP_DELIVERED=24h
LOCAL_KEEP_LATEST=1

# --- remote delivery (NFS mounted by the host) --------------------------
DELIVERY_ENABLED=true
# host mount point of the NFS export
DELIVERY_HOST_PATH=/mnt/mysql-backups
# optional: required first line of .mysql-backup-destination
DELIVERY_MARKER_ID=
DELIVERY_EXPECT_FSTYPE=nfs,nfs4
# EXAMPLE address/export
DELIVERY_EXPECT_SOURCE=192.0.2.10:/export/mysql-backups
DELIVERY_RETRY_INTERVAL=5m
DELIVERY_ATTEMPT_TIMEOUT=2h

# --- retention on the destination (tiers are a union) --------------------
RETENTION_KEEP_LATEST=3
# every recovery point of the latest 2 calendar days
RETENTION_HOURLY_DAYS=2
# newest point of each of the latest 14 days
RETENTION_DAILY_DAYS=14
# newest point of each of the latest 8 ISO weeks
RETENTION_WEEKLY_WEEKS=8

# --- status thresholds ---------------------------------------------------
# With 0 6-21 the overnight gap is ~9h; 26h tolerates one missed day.
STATUS_MAX_LOCAL_AGE=26h
STATUS_MAX_DELIVERED_AGE=26h
STATUS_MAX_PENDING_AGE=6h
